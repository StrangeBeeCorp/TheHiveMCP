# Apple files
.DS_Store

# VSCode files
*.code-workspace

# GoLand files
.idea/

# Local environment files (ignored files are also what Claude Code's Grep skips)
.env
.env.*
!.env.template

# Build directories
build/
tmp/
dist/

# Coverage files
coverage.out

# Editor settings
.vscode/

# Runtime-materialised TheHive test license (from THEHIVE_TEST_LICENSE); never
# committed — the raw JWT is a dev-mode secret. See docker-compose.license.yml.
internal/testutils/testdata/*.lic.local
# Minted dev license token (raw JWT — a secret; never commit).
key.md

# Claude Code: .claude/ and CLAUDE.md are the agent harness and are committed, except what
# belongs to one machine or one session. The public-safety gate refuses these if they slip in.
.claude/settings.local.json
.claude/worktrees/
.claude/logs/
.claude/last-prompt-ts
# The Tester's sealed tests of the task in progress, which the Coder may not read: never committed.
.claude/sealed/
CLAUDE.local.md

# The harness's build cache and run logs (bin/harness, .cache/harness/runs/).
.cache/
