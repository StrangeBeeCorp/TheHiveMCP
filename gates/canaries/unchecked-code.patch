+package utils
+
+import "testing"
+
+// The test runs the code, so coverage counts it, and checks nothing, so its mutants live.
+func TestPageEnd(t *testing.T) {
+	t.Parallel()
+
+	_ = PageEnd(0, 10, 25)
+	_ = PageEnd(20, 10, 25)
+	_ = ClampLimit(0, 1, 100)
+	_ = ClampLimit(500, 1, 100)
+	_ = ClampLimit(50, 1, 100)
+}
