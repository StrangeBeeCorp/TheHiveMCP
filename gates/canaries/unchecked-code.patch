+package utils
+
+// PageEnd is where a page of limit items from offset ends in a list of total, never past it.
+func PageEnd(offset, limit, total int) int {
+	end := offset + limit
+	if end > total {
+		end = total
+	}
+
+	if end < offset {
+		end = offset
+	}
+
+	return end
+}
+
+// ClampLimit holds a requested page size between lo and hi.
+func ClampLimit(n, lo, hi int) int {
+	if n < lo {
+		return lo
+	}
+
+	if n > hi {
+		return hi
+	}
+
+	return n
+}
