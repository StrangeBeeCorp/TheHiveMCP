#!/usr/bin/env bash
# The commit gates of gates/registry.yaml, selected by exactly what the commit carries (--staged):
# lint (scripts/lint.sh --staged, as before) plus the structure, public-safety and docs checks,
# which take well under a second. Unrelated work in progress can't fail the commit.
# Bypassable with `git commit --no-verify`.
exec "$(git rev-parse --show-toplevel)/bin/harness" run --cadence commit --staged
