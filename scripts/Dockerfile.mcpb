# The MCPB packer image: bin/harness package mcpb (internal/harness/release) lays out each
# extension in a workspace and runs this image on it, as the host user, to pack it.
FROM node:24-alpine

# The npm packer is pinned for reproducible release artifacts.
RUN npm install -g --ignore-scripts @anthropic-ai/mcpb@2.1.2

WORKDIR /workspace

# Drop root: the upstream node:alpine image ships a non-root "node" user; bin/harness runs the
# packer as the host user, so that it can write the mounted workspace.
USER node

ENTRYPOINT ["mcpb"]
